SECRET_KEY=tu-secret-key-aqui
DEBUG=True

# Datos de conexion a Supabase (pidelos al equipo, ver README) o a tu
# Postgres local si prefieres una copia propia para desarrollar sin conexion.
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=tu-password-aqui
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432

# Agrega tu IP de red local (ej. 192.168.1.100) para poder probar desde un
# celular fisico en la misma WiFi. Sin esto, Django rechaza la conexion con
# "Bad Request (400)". Consigue tu IP con `ipconfig` (Windows) o `ifconfig`.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origenes permitidos para peticiones desde el navegador (CORS). Agrega aqui
# la URL donde corra el panel de React si no es la de desarrollo por defecto.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dominios desde los que se acepta un POST con cookie de sesion (solo /admin/).
# En Render, agrega tu URL de servicio, ej: https://refood-backend.onrender.com
CSRF_TRUSTED_ORIGINS=

# Supabase Storage (S3-compatible) para las imagenes de producto. Sin estas
# variables, el proyecto guarda las imagenes en el filesystem local (sirve
# para desarrollo, pero se pierden en cada deploy de Render). Consigue estos
# valores en Supabase: Project Settings > Storage > S3 Connection.
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_ENDPOINT_URL=
SUPABASE_STORAGE_REGION=us-east-1